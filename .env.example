# DCU Theology Library Monitor Configuration

# Target URL (신학도서관 최근 60일 신착자료 기본값)
TARGET_URL="https://lib.cu.ac.kr/newarrival?st=SUBJ&bk_2=jttjb00culibjttj&sNo=0&newDate=60&sq=&oi=&os=DESC&cpp=100"

# Optional filter text
# INCLUDE_TEXT="신학도서관"

# ntfy Push Notification
NTFY_SERVER="https://ntfy.sh"
NTFY_TOPIC="dculibrary"

# Telegram Bot Notification (선택)
# TELEGRAM_BOT_TOKEN="123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ"
# TELEGRAM_CHAT_ID="YOUR_CHAT_ID"

# SMTP Email Notification (선택)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="your-email@gmail.com"
# EMAIL_TO="your-email@gmail.com"

# Proxy (대구가톨릭대 학내망 해외 IP 차단 우회 필요 시 국내 프록시 지정)
# PROXY_SERVER="http://proxy.example.kr:8080"

# Headless & Wait Settings
HEADLESS="true"
PAGE_WAIT_MS="4000"
MAX_ITEMS="100"
